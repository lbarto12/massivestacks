{
	"schemaVersion": 1,
	"id": "massivestacks",
	"version": "${version}",
	"name": "Massive Stacks",
	"description": "A mod to increase the maximum stack size to 1 billion items per slot.",
	"authors": [
		"lbarto12"
	],
	"contact": {
		"homepage": "https://github.com/lbarto12",
		"sources": "https://github.com/lbarto12/massivestacks"
	},
	"license": "CC0-1.0",
	"icon": "assets/massivestacks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"lbarto12.stacks.Stacks"
		],
		"client": [
			"lbarto12.stacks.client.StacksClient"
		]
	},
	"mixins": [
		{
			"config": "massivestacks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
