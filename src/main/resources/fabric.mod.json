{
	"schemaVersion": 1,
	"id": "massivestacks",
	"version": "${version}",
	"name": "Massive Stacks",
	"description": "Configurable item stack sizes, default 999 and up to one billion per slot. Adds exact-amount splitting, batch crafting and readable stack counts. Required on both server and client. Requires Fabric API; Mod Menu is optional for the settings screen.",
	"authors": [
		"lbarto12"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/massivestacks",
		"sources": "https://github.com/lbarto12/massivestacks"
	},
	"license": "CC0-1.0",
	"icon": "assets/massivestacks/icon.png",
	"environment": "*",
	"entrypoints": {
        "main": ["lbarto12.stacks.MassiveStacks"],
        "client": ["lbarto12.stacks.client.MassiveStacksClient"],
        "modmenu": ["lbarto12.stacks.client.screens.ModMenuIntegration"]
    },
	"mixins": [
		"massivestacks.mixins.json",
		{
			"config": "massivestacks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
